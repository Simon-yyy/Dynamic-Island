# ==========================================
# 1. 编译构建与调试临时文件 (保留 灵动岛.exe)
# ==========================================
# 仅忽略中间过程文件与调试符号，放行 灵动岛.exe 及发布时间戳
*.obj
*.pdb
*.ilk
*.exp
*.lib
bin/
obj/
build/
out/
dist/

# ==========================================
# 2. 运行时动态数据、本地配置与日志 (Runtime Data)
# ==========================================
# 忽略运行生成的临时状态、位置记录与日志
data/*.txt
data/*.log
data/*.error.txt
# 忽略用户个人自定义宠物图片
data/pet/custom.png
# 严格保留内置预置素材
!data/pet/presets/
!data/pet/presets/*.png

# 通用日志
*.log
logs/

# ==========================================
# 3. 安装部署清单 (Install Manifest)
# ==========================================
.island_manifest

# ==========================================
# 4. 测试与 Python 工具缓存 (Tools & Python)
# ==========================================
__pycache__/
tools/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# 5. IDE / 编辑器本地配置 (IDEs & Editors)
# ==========================================
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln.docstates

# ==========================================
# 6. AI 协作与工作记忆 (AI & Agent Runtime)
# ==========================================
.gemini/
.ai-memory/
.cursor/
.agents/
TASK.md

# ==========================================
# 7. 操作系统与临时文件 (OS & Temp)
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*~
*.swp
*.old
